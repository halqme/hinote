{
  "name": "hinote-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.13.19",
      "esbuild": "^0.28.2",
      "@hono/node-server": "^2.1.9"
    }
  },
  "type": "module",
  "scripts": {
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "oxlint --type-aware && bun run --filter './packages/*' lint",
    "format": "bun fmt",
    "build": "bun run --filter './packages/*' build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "hono": "catalog:",
    "oxdg": "^0.6.0",
    "oxlint": "^1.94.0",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.5",
      "onFail": "warn"
    }
  }
}
