{
  "name": "hinote",
  "version": "0.1.0",
  "private": false,
  "description": "Local slide tool using Hono and Hono/JSX",
  "license": "MIT",
  "author": "HALQME",
  "bin": {
    "hinote": "src/cli.ts"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "README.ja.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./code-themes": {
      "types": "./dist/code-themes.d.ts",
      "bun": "./src/code-themes.ts",
      "default": "./dist/code-themes.js"
    },
    "./preload": "./src/preload.ts"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.4"
    }
  },
  "scripts": {
    "dev": "bun src/cli.ts dev examples/deck.tsx",
    "build:client": "bun scripts/build-client.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "format": "bun fmt",
    "build:lib": "bun scripts/build-lib.ts",
    "prepack": "bun scripts/build-lib.ts"
  },
  "dependencies": {
    "@pierre/highlights": "^0.5.1"
  },
  "devDependencies": {
    "hono": "^4.13.19",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "hono": "^4.13.19"
  },
  "keywords": [
    "slides",
    "presentation",
    "hono",
    "jsx",
    "bun"
  ]
}
