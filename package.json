{
  "name": "hinote-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.13.21"
    }
  },
  "type": "module",
  "scripts": {
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "oxlint --type-aware && bun run --filter './packages/*' lint",
    "format": "bun fmt",
    "build": "bun run --filter './packages/*' build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "hono": "catalog:",
    "oxdg": "^0.6.0",
    "oxlint": "^1.95.0",
    "tsdown": "^0.23.7",
    "tsrs": "^7.1.0-beta.tsrs5",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.5",
      "onFail": "warn"
    }
  }
}
