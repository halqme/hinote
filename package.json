{
  "name": "hinote-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "oxlint --type-aware && bun run --filter './packages/*' lint",
    "format": "bun fmt"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "tsrs": "^0.25.0-ts7.1.0-beta"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.4",
      "onFail": "warn"
    }
  }
}
