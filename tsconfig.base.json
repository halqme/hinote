{
  // Compiler options every package shares. Each package's tsconfig.json
  // extends this and adds its own paths, include, and exclude.
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // The workspace's own packages, from source, so a package's tests use the
    // others without listing them as dependencies or building them first.
    "paths": {
      "hinote": ["./packages/hinote/src/index.ts"],
      "@hinote/core": ["./packages/core/src/index.ts"],
      "@hinote/core/client": ["./packages/core/src/client-global.ts"],
      "@hinote/core/internal": ["./packages/core/src/internal.ts"],
      "@hinote/types": ["./packages/types/index.d.ts"]
    }
  }
}
