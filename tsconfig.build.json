{
  // Type declarations for dist/. scripts/build-lib.ts writes the JavaScript.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/index.ts",
    "src/code-themes.ts",
    "src/css-module.d.ts",
    "src/client-global.ts"
  ],
  "exclude": []
}
