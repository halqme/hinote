{
  // What a package's tsconfig.build.json adds to its tsconfig.json, for
  // scripts/build-package.ts: declarations for each file in src/, one for
  // one, with `./x.ts` imports rewritten to `./x.js`.
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  }
}
