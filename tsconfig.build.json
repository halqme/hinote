{
  // What a package's tsconfig.build.json adds to its tsconfig.json: emit
  // JavaScript and declarations for each file in src/, one for one, with
  // `./x.ts` imports rewritten to `./x.js`. Nothing is bundled, so a deck's
  // bundler keeps only the modules the deck imports.
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  }
}
