{
  "name": "@hinote/core",
  "version": "0.5.2",
  "description": "Slides as a Hono app, written in Hono/JSX",
  "keywords": [
    "hono",
    "jsx",
    "presentation",
    "slides"
  ],
  "license": "MIT",
  "author": "HALQME",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halqme/hinote.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-global.d.ts",
      "default": "./dist/client-global.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun check && bun x tsc -p tsconfig.client.json --noEmit",
    "lint": "oxdg src --circular --fail-on-circular",
    "format": "bun fmt",
    "prepack": "bun scripts/build.ts",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@hinote/types": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "rolldown": "1.3.3"
  },
  "peerDependencies": {
    "hono": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
