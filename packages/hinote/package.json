{
  "name": "hinote",
  "version": "0.5.2",
  "private": false,
  "description": "Local slide tool using Hono and Hono/JSX",
  "keywords": [
    "bun",
    "hono",
    "jsx",
    "presentation",
    "slides"
  ],
  "license": "MIT",
  "author": "HALQME",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halqme/hinote.git",
    "directory": "packages/hinote"
  },
  "bin": {
    "hinote": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-global.d.ts",
      "default": "./dist/client-global.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun check && bun x tsc -p tsconfig.client.json --noEmit",
    "lint": "oxdg src --circular --fail-on-circular",
    "format": "bun fmt",
    "prepack": "bun scripts/build-lib.ts",
    "build": "bun scripts/build-lib.ts"
  },
  "dependencies": {
    "@hinote/types": "workspace:^",
    "rolldown": "1.3.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4"
  },
  "peerDependencies": {
    "hono": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.4",
      "onFail": "warn"
    }
  },
  "sideEffects": false
}
