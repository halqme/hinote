{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // The examples import "hinote"; check them against src/, not a built dist/.
    "paths": {
      "hinote": ["./src/index.ts"],
      "hinote/code-themes": ["./src/code-themes.ts"],
      "hinote/client": ["./src/client-global.ts"]
    }
  },
  // Each bench/ project resolves hinote only after bench/run.ts installs it.
  // client-global.ts declares the browser global. It applies to every file in
  // the program that includes it, so it and the browser files stay out of this
  // one; tsconfig.client.json checks those.
  "exclude": [
    "node_modules",
    "dist",
    "bench",
    "types",
    "src/client-global.ts",
    "**/*.client.ts",
    "**/*.client.tsx"
  ]
}
